PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Firebase Admin SDK credentials
# Put your service account JSON contents here as a single line string, or configure properties
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key

# JWT secret (fallback/additional authentication if needed)
JWT_SECRET=your_jwt_secret_key_here
